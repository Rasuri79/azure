						"          effective_start_dt,",
						"          effective_end_dt",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> insertselect",
						"newSelect sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          employee_sk as integer,",
						"          emp_id as integer,",
						"          first_name as string,",
						"          last_name as string,",
