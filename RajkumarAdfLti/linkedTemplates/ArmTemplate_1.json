						"          is_active as boolean,",
						"          effective_start_dt as date,",
						"          effective_end_dt as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          emp_id,",
						"          first_name,",
						"          last_name,",
						"          dept,",
						"          title,",
						"          email,",
						"          phone,",
						"          hashdiff,",
						"          is_active,",
						"          effective_start_dt,",
						"          effective_end_dt",
						"     )) ~> sinkInsert",
						"insertselect sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          employee_sk as integer,",
						"          emp_id as integer,",
						"          first_name as string,",
						"          last_name as string,",
						"          dept as string,",
						"          title as string,",
						"          email as string,",
						"          phone as string,",
						"          hashdiff as string,",
						"          is_active as boolean,",
						"          effective_start_dt as date,",
						"          effective_end_dt as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkChangedInsert",
						"expiredselect sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          employee_sk as integer,",
						"          emp_id as integer,",
						"          first_name as string,",
						"          last_name as string,",
						"          dept as string,",
